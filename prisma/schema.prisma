generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Coleta mínima de PII (Data Minimization, LGPD art. 6º): só nome, e-mail e
// hash de senha — nenhum campo "que pode ser útil um dia".
model Usuario {
  id         String   @id @default(uuid())
  nome       String
  email      String   @unique
  senhaHash  String
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("usuarios")
}
