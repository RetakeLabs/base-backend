# Copie para .env e preencha. O processo falha no boot (fail-fast) se faltar
# variável obrigatória — ver src/configuracao/ambiente.ts.

NODE_ENV=development
PORTA=3000

# Postgres (docker-compose.yml expõe em 5433 para não colidir com uma
# instância nativa na 5432). connection_limit deve ser calibrado como
# pool_size x réplicas da API, respeitando o teto de conexões do banco gerenciado.
DATABASE_URL="postgresql://usuario:senha@localhost:5433/base_backend?schema=public&connection_limit=10"

# CORS restritivo — lista de origens separadas por vírgula, nunca "*" com credentials.
CORS_ORIGENS_PERMITIDAS="http://localhost:5173"

# Nível de log: debug em dev, info/warn/error em produção (nunca debug sob carga real).
NIVEL_LOG=debug

# Segredo do access token (JWT HS256). Gere um valor real por ambiente com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nunca reutilize o valor de exemplo abaixo fora de desenvolvimento local.
JWT_SECRET="troque-este-valor-por-um-segredo-aleatorio-de-32-bytes-no-minimo"
